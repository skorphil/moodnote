---
import type { MoodDimension } from "../../poms-data/mood-dimensions";
import Layout from "../../layouts/Layout.astro";
import DimensionCard from "../../components/DimensionCard.astro";

const result = Astro.url.searchParams.get("result");
const [date, resultScores] = result
  ? Object.entries(JSON.parse(result))[0]
  : [null, null];
console.log("resScores< date:", resultScores, date);
---

<script>
  import { ls } from "../../lib/local-storage-helpers";
  const url = new URL(window.location.href);
  const searchParams = url.searchParams;
  const result = searchParams.get("result");
  const profile = {};
  //   console.log("date:vars", date);
  ls.set("moodnoteProfile", JSON.stringify(result));
</script>

<Layout title="moodnote">
  <main>
    <a class="logo" href="/">💙 moodnote.cc</a>
    <h1>Result {date}</h1>
    {
      result &&
        Object.entries(resultScores).map(([dimension, score], id) => (
          <DimensionCard
            dimension={dimension as MoodDimension}
            score={score as number}
            bg={id % 2 === 0}
          />
        ))
    }
  </main>
</Layout>
